# ms-notificaciones: avisos por correo (HU-03 confirmacion de carga; HU-01 bienvenida). Copiar a .env para desarrollo local.
NODE_ENV=development
PORT=3003
MONGO_URI=mongodb://localhost:27017/ms-notificaciones
RABBITMQ_URI=amqp://localhost:5672
OPERATOR_NAME=MiFolio

# console (desarrollo): NO envia nada, solo deja constancia del aviso en Mongo. smtp: envio real, OBLIGATORIO fuera de
# development/test (con console nadie recibiria los avisos).
EMAIL_TRANSPORT=console
MAIL_FROM=no-responder@carpetacolombia.co

# Solo con EMAIL_TRANSPORT=smtp. Fuera de local: credenciales obligatorias, contrasena que no sea la de un tutorial y
# SMTP_SECURITY=tls (465) o starttls (587). "none" solo en desarrollo local (p. ej. MailHog).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURITY=starttls
SMTP_TIMEOUT_MS=8000

# Un aviso "en proceso" mas viejo que esto se considera abandonado (el proceso murio a medias) y otro lo retoma
NOTIFICATION_STALE_CLAIM_MS=60000
