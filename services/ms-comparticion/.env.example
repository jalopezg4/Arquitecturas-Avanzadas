# ms-comparticion: comparticion autorizada de documentos (HU-06.1 registro de entidad institucional,
# ADR-07 autenticacion institucional). Copiar a .env para desarrollo local.
NODE_ENV=development
PORT=3005
MONGO_URI=mongodb://localhost:27017/ms-comparticion

# OPCIONAL. Si se define, POST /api/v1/institutions exige el encabezado x-registration-token con este valor (el operador
# se lo entrega a cada institucion al afiliarla). Vacio = registro ABIERTO, como pide el issue: cualquiera puede registrar
# una entidad, y HU-06.2 entregara documentos de ciudadanos a esa carpeta (ver docs/SEGURIDAD.md, seccion 10).
# Debe tener >= 24 caracteres aleatorios (ej.: openssl rand -hex 24); se rechazan placeholders.
REGISTRATION_TOKEN=

# ADR-07: llave con la que ESTE servicio firma los tokens INSTITUCIONALES (POST /api/v1/institutions/auth/token).
# Fuera de development/test es obligatoria: >= 32 caracteres aleatorios (ej.: openssl rand -hex 32).
# DEBE ser DISTINTA de JWT_SECRET (la de ciudadanos, de ms-identidad): son dos mundos separados a proposito.
# La conocen quienes VERIFICAN tokens institucionales (ms-gateway y, con HU-10, ms-documentos); ms-identidad no.
ENTITY_JWT_SECRET=cambiar-en-produccion
# Rotacion sin downtime: al cambiar ENTITY_JWT_SECRET, poner aqui la anterior (varias separadas por coma) hasta que
# expire el token mas longevo; luego retirarla. Mismo procedimiento de 3 fases que JWT_SECRET (docs/SEGURIDAD.md).
ENTITY_JWT_SECRET_PREVIOUS=
# Vigencia del token institucional. Tope de politica: 15 minutos (ADR-06). No hay refresh token para entidades.
ENTITY_ACCESS_EXPIRES_IN=15m
# Proteccion contra fuerza bruta en el login institucional (misma politica que HU-02 para ciudadanos).
ENTITY_MAX_ATTEMPTS=5
ENTITY_LOCK_MS=900000

# ADR-07: quien toma las decisiones de verificacion desde la consola (npm run verify:institution). Si se omite se
# usa --por=... y, en ultimo caso, el usuario del sistema operativo. Queda escrito en la entidad y en la bitacora.
VERIFICATION_DECIDED_BY=
