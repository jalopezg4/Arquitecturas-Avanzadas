# ms-gateway: enrutamiento y validacion de tokens. Copiar a .env para desarrollo local.
NODE_ENV=development
PORT=3000
# Servicios destino (cada microservicio nuevo agrega su URL aqui y sus rutas en src/routes.js)
IDENTIDAD_URL=http://localhost:3001
DOCUMENTOS_URL=http://localhost:3002
UPSTREAM_TIMEOUT_MS=10000
# Fuera de development/test, JWT_SECRET es obligatorio y DEBE ser la misma llave que usa ms-identidad
# (>= 32 caracteres aleatorios, ej.: openssl rand -hex 32). Durante una rotacion, las anteriores en
# JWT_SECRET_PREVIOUS (separadas por coma), igual que en ms-identidad (ver docs/SEGURIDAD.md).
JWT_SECRET=cambiar-en-produccion
JWT_SECRET_PREVIOUS=
JWT_ISSUER=ms-identidad
# TLS del propio gateway (opcional; ver docs/SEGURIDAD.md)
TLS_CERT_PATH=
TLS_KEY_PATH=
TLS_CA_PATH=
REQUIRE_TLS=false
