# Obligatorio (el servicio no arranca sin el): development | test | staging | production.
# Fuera de development/test se activan las validaciones estrictas de secretos y TLS.
NODE_ENV=development
PORT=3001
MONGO_URI=mongodb://localhost:27017/ms-identidad
RABBITMQ_URI=amqp://localhost:5672
GOVCARPETA_BASE_URL=https://govcarpeta-apis-4905ff3c005b.herokuapp.com
# 200 o 204: cual status de validateCitizen significa "disponible". Verificado
# empiricamente (2026-09-17): un documento nunca registrado devuelve 204, por eso el
# default es 204. Ver GovCarpetaClient.js si el comportamiento del sandbox cambia.
GOVCARPETA_AVAILABLE_STATUS=204
# Lo entrega `npm run register:operator` (o --write-env). En ambientes desplegados va como variable/secreto.
OPERATOR_ID=
OPERATOR_NAME=MiFolio
# Datos para registrar el operador (HU-11): una sola vez por ambiente con `npm run register:operator`.
# OPERATOR_NAME debe ser unico en el directorio COMPARTIDO de GovCarpeta (el registro no se puede borrar).
# Entre comillas: dotenv trata ` #` como comentario y cortaria la direccion.
OPERATOR_ADDRESS="Carrera 49 # 7 Sur-50, Medellin"
OPERATOR_CONTACT_MAIL=contacto@ejemplo.com
OPERATOR_PARTICIPANTS=Nombre Apellido,Nombre Apellido,Nombre Apellido
# Cuanto espera la confirmacion del broker antes de responder igual (ADR-04).
EVENT_PUBLISH_TIMEOUT_MS=3000
# Reconciliacion de registros (0 = desactivada): resuelve los pendientes ambiguos y reenvia ciudadano.registrado.
RECONCILE_INTERVAL_MS=60000
RECONCILE_MIN_AGE_MS=300000
# Fuera de development/test, JWT_SECRET es obligatorio: >= 32 caracteres aleatorios (ej.: openssl rand -hex 32).
# Este placeholder es RECHAZADO al arrancar en produccion.
JWT_SECRET=cambiar-en-produccion
# Rotacion sin downtime: al cambiar JWT_SECRET, poner aqui la llave anterior (varias separadas por coma)
# hasta que expire el token mas longevo; luego retirarla. Ver docs/SEGURIDAD.md.
JWT_SECRET_PREVIOUS=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SERVICE_NAME=ms-identidad
# TLS opcional del propio servicio. Con certificado+llave sirve HTTPS (TLS 1.3 minimo); si ademas se
# define TLS_CA_PATH exige certificado de cliente (mTLS). REQUIRE_TLS=true obliga a configurarlo.
TLS_CERT_PATH=
TLS_KEY_PATH=
TLS_CA_PATH=
REQUIRE_TLS=false
# Vigencia de URLs prefirmadas en segundos. Topes de politica (ADR-06): auth <= 900, descarga <= 3600.
PRESIGNED_URL_AUTH_TTL_SECONDS=900
PRESIGNED_URL_DOWNLOAD_TTL_SECONDS=3600
