# ms-analitica: servicios Premium y analitica de metadatos (HU-07). Copiar a .env para desarrollo local.
NODE_ENV=development
PORT=3006
MONGO_URI=mongodb://localhost:27017/ms-analitica

# ADR-07 -- aqui solo se VERIFICAN los tokens institucionales que firma ms-comparticion; debe ser la misma llave
# que alli. Protege /api/v1/cases (HU-07.2) y /api/v1/analytics/summary (HU-07.1). En development cae a la misma
# llave de desarrollo que los demas servicios; fuera de local es obligatoria (el servicio no arranca sin ella).
ENTITY_JWT_SECRET=

# HU-07.1 -- endpoint interno de agregacion de metadatos. En Docker Compose es el nombre DNS del servicio
# (http://ms-documentos:3002), nunca localhost. El Authorization que llega a ms-analitica se reenvia tal cual.
DOCUMENTOS_URL=http://localhost:3002
DOCUMENTS_ANALYTICS_TIMEOUT_MS=5000
