# ms-interoperabilidad: directorio de operadores de GovCarpeta (HU-05a). Copiar a .env para desarrollo local.
NODE_ENV=development
PORT=3004
MONGO_URI=mongodb://localhost:27017/ms-interoperabilidad
GOVCARPETA_BASE_URL=https://govcarpeta-apis-4905ff3c005b.herokuapp.com
GOVCARPETA_TIMEOUT_MS=10000

# Nuestro propio operador (ver docs/OPERADOR_MINTIC.md): nunca puede ser el destino de una transferencia.
OPERATOR_ID=

# Politica de refresco del directorio local (ver docs/SEGURIDAD.md, seccion 9)
# - vigencia: pasada, se refresca ANTES de usar el directorio (1 min a 1 dia)
OPERATOR_DIRECTORY_TTL_MINUTES=60
# - si GovCarpeta no responde, para BUSCAR se sirve la copia vieja hasta este limite (nunca para resolver una direccion de transferencia)
OPERATOR_DIRECTORY_MAX_STALE_MINUTES=1440
# - operador no encontrado / sin direccion: se intenta 1 refresco forzado, no mas de uno cada tantos segundos
MIN_FORCED_REFRESH_SECONDS=30

# Las direcciones de transferencia las publican OTROS operadores (no confiables). false = se rechazan localhost, IPs
# privadas, credenciales en la URL, etc. (SSRF). true SOLO en desarrollo local; fuera de local el arranque lo prohibe.
ALLOW_PRIVATE_OPERATOR_URLS=false
# true = solo https. Por defecto false: varios operadores del curso publican http://
REQUIRE_HTTPS_OPERATOR_URLS=false
