# ms-autenticacion: autenticacion de documentos con GovCarpeta (HU-04). Copiar a .env para desarrollo local.
NODE_ENV=development
PORT=3007
MONGO_URI=mongodb://localhost:27017/ms-autenticacion
RABBITMQ_URI=amqp://localhost:5672

# Object storage de ms-documentos: aqui SOLO se firman URLs de lectura. Fuera de development/test el endpoint debe ser
# https y las credenciales NO pueden ser las de tutorial (minioadmin...); idealmente, de solo lectura sobre el bucket.
S3_ENDPOINT=http://localhost:9000
# Host con el que GovCarpeta alcanza al storage (la URL se firma para el). Debe ser alcanzable desde internet:
# con MinIO en localhost el sandbox real NO puede descargar el documento.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=carpeta-documentos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_CONNECT_TIMEOUT_MS=1500
S3_REQUEST_TIMEOUT_MS=2500

# Vigencia de la URL que se entrega a GovCarpeta (ADR-06: 15 minutos como maximo)
PRESIGNED_URL_AUTH_TTL_SECONDS=900

# GovCarpeta (https fuera de development/test). Maximo 3 intentos con espera creciente (HU-04).
GOVCARPETA_BASE_URL=https://govcarpeta-apis-4905ff3c005b.herokuapp.com
GOVCARPETA_TIMEOUT_MS=10000
GOVCARPETA_MAX_ATTEMPTS=3
GOVCARPETA_BASE_DELAY_MS=1000

# Cuanto espera la confirmacion del broker al publicar el resultado
EVENT_PUBLISH_TIMEOUT_MS=3000
