# ms-documentos: carga de documentos (HU-03). Copiar a .env para desarrollo local.
NODE_ENV=development
PORT=3002
MONGO_URI=mongodb://localhost:27017/ms-documentos
RABBITMQ_URI=amqp://localhost:5672

# Debe ser la MISMA llave que usa ms-identidad para firmar (>= 32 caracteres aleatorios fuera de development/test,
# ej.: openssl rand -hex 32). Durante una rotacion, las anteriores en JWT_SECRET_PREVIOUS (separadas por coma).
JWT_SECRET=cambiar-en-produccion
JWT_SECRET_PREVIOUS=
JWT_ISSUER=ms-identidad

# Object storage S3-compatible. En desarrollo: MinIO (docker compose). Fuera de development/test el endpoint debe ser
# https y las credenciales NO pueden ser las de tutorial (minioadmin...). Solo se guarda la CLAVE del objeto en Mongo.
S3_ENDPOINT=http://localhost:9000
# Host con el que el NAVEGADOR alcanza al storage (las URLs prefirmadas se firman para el). Vacio = el mismo S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=carpeta-documentos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Plazos del cliente S3 (2 intentos deben rendirse antes que el gateway: 2 x (conexion + solicitud) <= 9000 ms)
S3_CONNECT_TIMEOUT_MS=1500
S3_REQUEST_TIMEOUT_MS=2500

# Cuota de documentos NO certificados por ciudadano (RNF-04) y tamano maximo por archivo (tope duro: 50 MB)
QUOTA_NO_CERTIFICADOS=5
MAX_UPLOAD_BYTES=10485760
# Vigencia de la URL de descarga (ADR-06: 1 hora como maximo)
PRESIGNED_URL_DOWNLOAD_TTL_SECONDS=3600
# Cuanto espera la confirmacion del broker antes de responder igual (la notificacion no es camino critico)
EVENT_PUBLISH_TIMEOUT_MS=3000

# Reenvio de eventos documento.cargado que no se pudieron publicar (0 = desactivado). MIN_AGE evita duplicar uno en curso.
RECONCILE_INTERVAL_MS=60000
RECONCILE_MIN_AGE_MS=60000
# TLS del propio servicio (opcional; ver docs/SEGURIDAD.md)
TLS_CERT_PATH=
TLS_KEY_PATH=
TLS_CA_PATH=
REQUIRE_TLS=false
